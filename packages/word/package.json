{
  "version": "0.0.2",
  "publisher": "craft-vscode-dev",
  "license": "MIT",
  "preview": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/yairkl/craft-vscode.git"
  },
  "engines": {
    "vscode": "^1.102.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "name": "craft-word",
  "displayName": "Craft Word",
  "description": "Native WordCraft DOCX viewing and editing in VS Code.",
  "categories": [
    "Other"
  ],
  "main": "./out/src/entrypoints/word.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "craft.word.preview",
        "displayName": "Craft Word",
        "selector": [
          {
            "filenamePattern": "*.docx"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "craft.word.integrationProbe",
        "displayName": "Craft Word Integration Probe (development)",
        "selector": [
          {
            "filenamePattern": "*.docx"
          }
        ],
        "priority": "option"
      }
    ]
  },
  "files": [
    "out/**",
    "media/**",
    "notices/**",
    "README.md",
    "LICENSE"
  ]
}
