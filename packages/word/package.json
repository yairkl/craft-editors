{
  "version": "0.1.6",
  "publisher": "craft-vscode-dev",
  "license": "MIT",
  "preview": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/yairkl/craft-editors.git"
  },
  "engines": {
    "vscode": "^1.102.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "name": "craft-word",
  "displayName": "Craft Documents",
  "description": "Native WordCraft DOCX viewing and editing in VS Code.",
  "categories": [
    "Other"
  ],
  "main": "./out/src/entrypoints/word.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "craft.word.mcp",
        "label": "Craft Documents"
      }
    ],
    "customEditors": [
      {
        "viewType": "craft.word.preview",
        "displayName": "Craft Documents",
        "selector": [
          {
            "filenamePattern": "*.docx"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "craft.word.integrationProbe",
        "displayName": "Craft Documents Integration Probe (development)",
        "selector": [
          {
            "filenamePattern": "*.docx"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "craft.word.markdown",
        "displayName": "Craft Documents",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "option"
      }
    ],
    "configuration": {
      "title": "Craft Documents",
      "properties": {
        "craft.word.maxFileSizeMiB": {
          "type": "integer",
          "default": 256,
          "minimum": 1,
          "maximum": 1024,
          "scope": "resource",
          "description": "Maximum document size in MiB for opening and saving. Large or complex documents may require substantially more memory."
        }
      }
    },
    "commands": [
      {
        "command": "craft.word.openMarkdownText",
        "title": "Open Markdown as Text",
        "icon": "$(code)"
      },
      {
        "command": "craft.word.openMarkdownDocument",
        "title": "Open Markdown in Craft Documents",
        "icon": "$(edit)"
      },
      {
        "command": "craft.word.saveMarkdownAsDocument",
        "title": "Craft Documents: Save Markdown as Word Document"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "craft.word.openMarkdownText",
          "when": "resourceExtname == .md && activeCustomEditorId == 'craft.word.markdown'",
          "group": "navigation@10"
        },
        {
          "command": "craft.word.openMarkdownDocument",
          "when": "resourceExtname == .md && activeEditor == 'workbench.editors.files.textFileEditor'",
          "group": "navigation@10"
        }
      ]
    }
  },
  "files": [
    "out/**",
    "media/**",
    "notices/**",
    "README.md",
    "LICENSE",
    "icon.png"
  ],
  "extensionKind": [
    "workspace"
  ],
  "icon": "icon.png"
}
