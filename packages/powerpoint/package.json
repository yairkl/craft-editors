{
  "version": "0.1.3",
  "publisher": "craft-vscode-dev",
  "license": "MIT",
  "preview": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/yairkl/craft-vscode.git"
  },
  "engines": {
    "vscode": "^1.102.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "name": "craft-powerpoint",
  "displayName": "Craft PowerPoint",
  "description": "Native DeckCraft PPTX viewing and editing in VS Code.",
  "categories": [
    "Other"
  ],
  "main": "./out/src/entrypoints/powerpoint.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "craft.powerpoint.mcp",
        "label": "Craft PowerPoint"
      }
    ],
    "customEditors": [
      {
        "viewType": "craft.powerpoint.preview",
        "displayName": "Craft PowerPoint",
        "selector": [
          {
            "filenamePattern": "*.pptx"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "craft.powerpoint.integrationProbe",
        "displayName": "Craft PowerPoint Integration Probe (development)",
        "selector": [
          {
            "filenamePattern": "*.pptx"
          }
        ],
        "priority": "option"
      }
    ],
    "configuration": {
      "title": "Craft PowerPoint",
      "properties": {
        "craft.powerpoint.maxFileSizeMiB": {
          "type": "integer",
          "default": 256,
          "minimum": 1,
          "maximum": 1024,
          "scope": "resource",
          "description": "Maximum document size in MiB for opening and saving. Large or complex documents may require substantially more memory."
        }
      }
    }
  },
  "files": [
    "out/**",
    "media/**",
    "notices/**",
    "README.md",
    "LICENSE"
  ],
  "extensionKind": [
    "workspace"
  ]
}
