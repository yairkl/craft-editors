{
  "version": "0.1.6",
  "publisher": "craft-vscode-dev",
  "license": "MIT",
  "preview": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/yairkl/craft-editors.git"
  },
  "engines": {
    "vscode": "^1.102.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "name": "craft-pdf",
  "displayName": "Craft PDF",
  "description": "Edit and annotate PDF documents with PdfCraft inside VS Code.",
  "categories": [
    "Other"
  ],
  "main": "./out/src/entrypoints/pdf.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "craft.pdf.mcp",
        "label": "Craft PDF"
      }
    ],
    "customEditors": [
      {
        "viewType": "craft.pdf.preview",
        "displayName": "Craft PDF (read only)",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "craft.pdf.integrationProbe",
        "displayName": "Craft PDF Integration Probe (development)",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ],
        "priority": "option"
      }
    ],
    "configuration": {
      "title": "Craft PDF",
      "properties": {
        "craft.pdf.maxFileSizeMiB": {
          "type": "integer",
          "default": 256,
          "minimum": 1,
          "maximum": 1024,
          "scope": "resource",
          "description": "Maximum document size in MiB for opening and saving. Large or complex documents may require substantially more memory."
        }
      }
    }
  },
  "files": [
    "out/**",
    "media/**",
    "notices/**",
    "README.md",
    "LICENSE",
    "icon.png"
  ],
  "extensionKind": [
    "workspace"
  ],
  "icon": "icon.png"
}
