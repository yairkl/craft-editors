{
  "version": "0.1.2",
  "publisher": "craft-vscode-dev",
  "license": "MIT",
  "preview": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/yairkl/craft-vscode.git"
  },
  "engines": {
    "vscode": "^1.102.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "name": "craft-pdf",
  "displayName": "Craft PDF",
  "description": "Edit and annotate PDF documents with PdfCraft inside VS Code.",
  "categories": [
    "Other"
  ],
  "main": "./out/src/entrypoints/pdf.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "craft.pdf.mcp",
        "label": "Craft PDF"
      }
    ],
    "customEditors": [
      {
        "viewType": "craft.pdf.preview",
        "displayName": "Craft PDF (read only)",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "craft.pdf.integrationProbe",
        "displayName": "Craft PDF Integration Probe (development)",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ],
        "priority": "option"
      }
    ]
  },
  "files": [
    "out/**",
    "media/**",
    "notices/**",
    "README.md",
    "LICENSE"
  ],
  "extensionKind": [
    "workspace"
  ]
}
