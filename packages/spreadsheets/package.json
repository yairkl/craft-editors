{
  "version": "0.1.6",
  "publisher": "craft-vscode-dev",
  "license": "MIT",
  "preview": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/yairkl/craft-editors.git"
  },
  "engines": {
    "vscode": "^1.102.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "name": "craft-spreadsheets",
  "displayName": "Craft Spreadsheets",
  "description": "Native GridCraft XLSX, CSV and TSV viewing and editing in VS Code.",
  "categories": [
    "Other"
  ],
  "main": "./out/src/entrypoints/spreadsheets.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "craft.spreadsheets.mcp",
        "label": "Craft Spreadsheets"
      }
    ],
    "customEditors": [
      {
        "viewType": "craft.spreadsheets.preview",
        "displayName": "Craft Spreadsheets",
        "selector": [
          {
            "filenamePattern": "*.xlsx"
          },
          {
            "filenamePattern": "*.csv"
          },
          {
            "filenamePattern": "*.tsv"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "craft.spreadsheets.integrationProbe",
        "displayName": "Craft Spreadsheets Integration Probe (development)",
        "selector": [
          {
            "filenamePattern": "*.xlsx"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "craft.spreadsheets.saveAsWorkbook",
        "title": "Craft Spreadsheets: Save CSV or TSV as Excel Workbook"
      },
      {
        "command": "craft.spreadsheets.openCsvText",
        "title": "Open CSV as Text",
        "icon": "$(code)"
      },
      {
        "command": "craft.spreadsheets.openCsvGrid",
        "title": "Open CSV as Spreadsheet",
        "icon": "$(table)"
      },
      {
        "command": "craft.spreadsheets.openTsvText",
        "title": "Open TSV as Text",
        "icon": "$(code)"
      },
      {
        "command": "craft.spreadsheets.openTsvGrid",
        "title": "Open TSV as Spreadsheet",
        "icon": "$(table)"
      }
    ],
    "configuration": {
      "title": "Craft Spreadsheets",
      "properties": {
        "craft.spreadsheets.maxFileSizeMiB": {
          "type": "integer",
          "default": 256,
          "minimum": 1,
          "maximum": 1024,
          "scope": "resource",
          "description": "Maximum document size in MiB for opening and saving. Large or complex documents may require substantially more memory."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "craft.spreadsheets.openCsvText",
          "when": "resourceExtname == .csv && activeCustomEditorId == 'craft.spreadsheets.preview'",
          "group": "navigation@10"
        },
        {
          "command": "craft.spreadsheets.openCsvGrid",
          "when": "resourceExtname == .csv && activeEditor == 'workbench.editors.files.textFileEditor'",
          "group": "navigation@10"
        },
        {
          "command": "craft.spreadsheets.openTsvText",
          "when": "resourceExtname == .tsv && activeCustomEditorId == 'craft.spreadsheets.preview'",
          "group": "navigation@10"
        },
        {
          "command": "craft.spreadsheets.openTsvGrid",
          "when": "resourceExtname == .tsv && activeEditor == 'workbench.editors.files.textFileEditor'",
          "group": "navigation@10"
        }
      ]
    }
  },
  "files": [
    "out/**",
    "media/**",
    "notices/**",
    "README.md",
    "LICENSE",
    "icon.png"
  ],
  "extensionKind": [
    "workspace"
  ],
  "icon": "icon.png"
}
