{
  "version": "0.1.0",
  "publisher": "craft-vscode-dev",
  "license": "MIT",
  "preview": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/yairkl/craft-vscode.git"
  },
  "engines": {
    "vscode": "^1.102.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "name": "craft-spreadsheets",
  "displayName": "Craft Spreadsheets",
  "description": "Native GridCraft XLSX and CSV viewing and editing in VS Code.",
  "categories": [
    "Other"
  ],
  "main": "./out/src/entrypoints/spreadsheets.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "craft.spreadsheets.preview",
        "displayName": "Craft Spreadsheets",
        "selector": [
          {
            "filenamePattern": "*.xlsx"
          },
          {
            "filenamePattern": "*.csv"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "craft.spreadsheets.integrationProbe",
        "displayName": "Craft Spreadsheets Integration Probe (development)",
        "selector": [
          {
            "filenamePattern": "*.xlsx"
          }
        ],
        "priority": "option"
      }
    ]
  },
  "files": [
    "out/**",
    "media/**",
    "notices/**",
    "README.md",
    "LICENSE"
  ],
  "extensionKind": [
    "workspace"
  ]
}
