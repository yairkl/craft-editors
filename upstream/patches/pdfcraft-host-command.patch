+
+#[cfg(test)]
+mod host_command_tests {
+    use super::*;
+    use std::cell::Cell;
+    use std::rc::Rc;
+
+    #[test]
+    fn host_commands_do_not_redirect_a_standalone_background_tab_close() {
+        let mut app = PdfCraftApp::new();
+        let bytes = include_bytes!("../tests/data/form.pdf").to_vec();
+        app.open_bytes("first.pdf", None, bytes.clone()).unwrap();
+        app.open_bytes("second.pdf", None, bytes).unwrap();
+        let second = app.views[1].view_key();
+        let calls = Rc::new(Cell::new(0));
+        let seen = Rc::clone(&calls);
+        app.host_command = Some(Box::new(move |id| {
+            if id == "file.close" { seen.set(seen.get() + 1); return true; }
+            false
+        }));
+        app.close_tab(0);
+        assert_eq!(calls.get(), 0, "a generic host command cannot identify the requested tab");
+        assert_eq!(app.views.len(), 1);
+        assert_eq!(app.views[0].view_key(), second);
+    }
+
+    #[test]
+    fn optional_host_dispatch_preserves_the_standalone_fallback() {
+        let mut standalone = PdfCraftApp::new();
+        assert!(!standalone.execute("host.test.unknown"));
+        let calls = Rc::new(Cell::new(0));
+        let seen = Rc::clone(&calls);
+        let mut hosted = PdfCraftApp::new();
+        hosted.host_command = Some(Box::new(move |id| {
+            seen.set(seen.get() + 1);
+            matches!(id, "host.test.handled" | "file.close")
+        }));
+        assert!(hosted.execute("host.test.handled"));
+        assert!(!hosted.execute("host.test.unknown"));
+        assert_eq!(calls.get(), 2);
+    }
+}
