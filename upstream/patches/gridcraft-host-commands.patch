+
+#[cfg(test)]
+mod host_command_tests {
+    use super::*;
+    use crate::services::Services;
+    use gridcraft_engine::Session;
+    use std::cell::Cell;
+    use std::rc::Rc;
+
+    #[test]
+    fn optional_host_dispatch_preserves_the_standalone_fallback() {
+        let mut standalone = SheetApp::new(Session::new(), Services::default());
+        assert!(standalone.run("host.test.unknown", json!({})).is_err());
+
+        let calls = Rc::new(Cell::new(0));
+        let seen = Rc::clone(&calls);
+        let services = Services {
+            host_command: Some(Box::new(move |id| {
+                seen.set(seen.get() + 1);
+                id == "host.test.handled"
+            })),
+            ..Default::default()
+        };
+        let mut hosted = SheetApp::new(Session::new(), services);
+        assert_eq!(hosted.run("host.test.handled", json!({})).unwrap(), Json::Null);
+        assert!(hosted.run("host.test.unknown", json!({})).is_err());
+        assert_eq!(calls.get(), 2);
+    }
+}
