+#[test]
+fn standalone_title_controls_are_omitted_only_when_embedded() {
+    let session = || wordcraft_engine::Session::new(wordcraft_doc::Document::new());
+    let mut standalone = WordApp::new(session(), crate::Services::default());
+    let (standalone_ctx, mut n) = (ctx(), 0);
+    frame(&standalone_ctx, &mut n, vec![], &mut standalone);
+    assert!(standalone_ctx.read_response(undo_list_button_id()).is_some());
+
+    let mut embedded = WordApp::new(session(), crate::Services { embedded: true, ..Default::default() });
+    let (embedded_ctx, mut n) = (ctx(), 0);
+    frame(&embedded_ctx, &mut n, vec![], &mut embedded);
+    assert!(embedded_ctx.read_response(undo_list_button_id()).is_none());
+}
