index 8bd4b808982b6f52b32ad3b6c188940e23df59ff..afb9063503b3d097c9571721e53e787659f89999 100644
--- a/crates/ui-egui/src/tests.rs
+++ b/crates/ui-egui/src/tests.rs
@@ -7001,3 +7001,46 @@ fn focus_hides_the_ribbon_and_escape_brings_it_back() {
     h.step();
     assert!(h.state().session.view.read_mode && shown(&h, "Focus"), "Immersive Reader keeps the status bar");
 }
+
+/// Embedded hosts start with the ribbon collapsed. A single click on a tab must open it, as it
+/// does in Word; a double click then collapses it again, and a double click on a collapsed
+/// ribbon leaves it open rather than opening and shutting it in one gesture.
+#[test]
+fn embedded_collapsed_ribbon_opens_on_a_single_tab_click() {
+    fn double_click_tab(h: &mut egui_kittest::Harness<'static, WordApp>, label: &str) {
+        use egui_kittest::kittest::Queryable;
+        let pos = h.get_by_label(label).rect().center();
+        h.event(egui::Event::PointerMoved(pos));
+        h.run_steps(1);
+        // Every queued event is a frame; the harness must step less than egui's 0.3 s double-click delay.
+        for _ in 0..2 {
+            for pressed in [true, false] {
+                h.event(egui::Event::PointerButton { pos, button: egui::PointerButton::Primary, pressed, modifiers: Default::default() });
+            }
+        }
+        h.run_steps(10); // past the double-click delay, so gestures stay separate
+    }
+    use egui_kittest::kittest::Queryable;
+    let mut a = WordApp::new(Session::new(wordcraft_doc::Document::new()), Services { embedded: true, ..Default::default() });
+    a.ui.ribbon_collapsed = true;
+    let mut h = egui_kittest::Harness::builder().with_size(egui::vec2(1440.0, 900.0)).with_step_dt(0.05).build_ui_state(
+        |ui, app: &mut WordApp| {
+            let ctx = ui.ctx().clone();
+            app.logic(&ctx);
+            app.ui(ui);
+        },
+        a,
+    );
+    h.run_steps(4);
+    h.get_by_label("Insert").click();
+    h.run_steps(10); // past the double-click delay, so gestures stay separate
+    assert_eq!(h.state().ui.tab, "Insert");
+    assert!(!h.state().ui.ribbon_collapsed, "one click on a tab opens the collapsed ribbon");
+    h.get_by_label("Insert").click();
+    h.run_steps(10); // past the double-click delay, so gestures stay separate
+    assert!(!h.state().ui.ribbon_collapsed, "clicking the open ribbon's tab keeps it open");
+    double_click_tab(&mut h, "Insert");
+    assert!(h.state().ui.ribbon_collapsed, "a double click on an open ribbon collapses it");
+    double_click_tab(&mut h, "Insert");
+    assert!(!h.state().ui.ribbon_collapsed, "a double click on a collapsed ribbon opens it and leaves it open");
+}
