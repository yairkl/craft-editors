+        crate::theme::install_fonts(&ctx);
+        let mut standalone = ctx.run_ui(egui::RawInput::default(), |ui| title_bar(&mut app, ui));
+        standalone.textures_delta.clear();
+        assert!(!standalone.shapes.is_empty(), "standalone title bar is drawn");
+        app.services.embedded = true;
+        let ctx = egui::Context::default();
+        crate::theme::install_fonts(&ctx);
+        let mut embedded = ctx.run_ui(egui::RawInput::default(), |ui| title_bar(&mut app, ui));
+        embedded.textures_delta.clear();
+        assert!(embedded.shapes.is_empty(), "the host supplies its own title bar");
