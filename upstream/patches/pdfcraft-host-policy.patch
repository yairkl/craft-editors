+
+#[cfg(test)]
+mod embedded_close_tests {
+    use crate::PdfCraftApp;
+    use std::cell::Cell;
+    use std::rc::Rc;
+
+    #[test]
+    fn single_document_host_only_receives_valid_close_requests() {
+        let mut app = PdfCraftApp::new();
+        app.embedded = true;
+        app.open_bytes("only.pdf", None, include_bytes!("../../tests/data/form.pdf").to_vec()).unwrap();
+        let calls = Rc::new(Cell::new(0));
+        let seen = Rc::clone(&calls);
+        app.host_command = Some(Box::new(move |id| {
+            if id == "file.close" { seen.set(seen.get() + 1); return true; }
+            false
+        }));
+        app.close_tab(9);
+        assert_eq!(calls.get(), 0);
+        app.close_tab(0);
+        assert_eq!(calls.get(), 1);
+        assert_eq!(app.views.len(), 1, "the host owns closing the embedded document");
+    }
+}
