+/// Live text/form drafts retained alongside the host's committed model snapshots.
+#[derive(Clone)]
+pub struct HostDraftSnapshot {
+    content: content_ui::ContentView,
+    line: Option<edit_text_ui::LineEditor>,
+    form: forms_ui::FormView,
+    fill: Option<fill_sign::TypeBox>,
+    pending: Option<pdfcraft_engine::Edit>,
+}
+impl HostDraftSnapshot {
+    pub fn text(&self) -> String {
+        [
+            self.content.draft.as_ref().map(|d| d.text.as_str()).unwrap_or_default(),
+            self.line.as_ref().filter(|d| d.has_changes()).map(|d| d.text.as_str()).unwrap_or_default(),
+            self.form.focus.as_ref().map(|d| d.text.as_str()).unwrap_or_default(),
+            self.fill.as_ref().map(|d| d.text.as_str()).unwrap_or_default(),
+        ]
+        .join("\u{0}")
+    }
+}
