+/// Exact, reusable snapshots for an embedding host's undo/redo callbacks.
+#[derive(Clone)]
+pub struct HostSnapshot {
+    doc: Document,
+    sel: Selection,
+    pending: Option<CharProps>,
+    column: Option<ColumnBlock>,
+    evicted: u64,
+    history: Vec<Arc<Undo>>,
+    redo: Vec<Arc<Undo>>,
+}
+
+impl Session {
+    pub fn host_snapshot(&self) -> HostSnapshot {
+        HostSnapshot { doc: self.doc.clone(), sel: self.sel.clone(), pending: self.pending.clone(),
+            column: self.column.clone(), evicted: self.undo_evicted, history: self.history.clone(), redo: self.redo.clone() }
+    }
+    pub fn restore_host_snapshot(&mut self, snapshot: HostSnapshot) {
+        self.note_body_replaced();
+        self.doc = snapshot.doc; self.sel = snapshot.sel; self.pending = snapshot.pending;
+        self.column = snapshot.column; self.undo_evicted = snapshot.evicted; self.autocap = None; self.history = snapshot.history; self.redo = snapshot.redo;
+        self.typing_open = false; self.join_next = false; self.equation_join_next = false; self.ime_text_join = None; self.join_anchor = false;
+        self.also_selected.clear(); self.clamp_selection(); self.touch();
+    }
+}
+
