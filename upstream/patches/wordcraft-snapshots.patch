+
+#[test]
+fn host_snapshots_restore_document_and_history_repeatedly() {
+    let mut s = Session::new(wordcraft_doc::Document::new());
+    run(&mut s, "text.insert", json!({"text": "first"}));
+    let first = s.doc.clone();
+    let snapshot = s.host_snapshot();
+    let first_depth = s.undo_depth();
+
+    run(&mut s, "text.insert", json!({"text": " second"}));
+    assert_ne!(s.doc, first);
+    s.restore_host_snapshot(snapshot.clone());
+    assert_eq!(s.doc, first);
+    assert_eq!(s.undo_depth(), first_depth);
+    run(&mut s, "edit.undo", json!({}));
+    assert_ne!(s.doc, first);
+    run(&mut s, "edit.redo", json!({}));
+    assert_eq!(s.doc, first);
+
+    run(&mut s, "text.insert", json!({"text": " changed"}));
+    s.restore_host_snapshot(snapshot);
+    assert_eq!(s.doc, first);
+    assert_eq!(s.undo_depth(), first_depth);
+}
