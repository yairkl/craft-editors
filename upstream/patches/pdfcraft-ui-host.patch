+
+#[cfg(test)]
+mod host_chrome_tests {
+    use egui_kittest::{Harness, kittest::Queryable};
+
+    #[test]
+    fn standalone_document_tab_is_omitted_when_embedded() {
+        fn tabs(embedded: bool) -> usize {
+            let mut h = Harness::builder().with_size(egui::vec2(1200.0, 800.0)).build_eframe(move |_| {
+                let mut app = crate::PdfCraftApp::new();
+                app.embedded = embedded;
+                app.open_bytes("seam-chrome-test.pdf", None, include_bytes!("../tests/data/form.pdf").to_vec()).unwrap();
+                app
+            });
+            h.run_steps(4);
+            h.query_all_by_label("seam-chrome-test.pdf").count()
+        }
+        assert!(tabs(false) > 0, "standalone document tab remains available");
+        assert_eq!(tabs(true), 0, "embedded host supplies the document tabs");
+    }
+}
