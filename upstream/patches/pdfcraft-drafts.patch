+    pub fn host_draft(&self) -> Option<crate::HostDraftSnapshot> {
+        let v = self.active.and_then(|i| self.views.get(i))?;
+        Some(crate::HostDraftSnapshot {
+            content: v.content.clone(), line: v.line_editor.clone(), form: v.forms.clone(),
+            fill: v.fill_text.clone(), pending: v.pending_edit.clone(),
+        })
+    }
+    pub fn host_restore_draft(&mut self, draft: &Option<crate::HostDraftSnapshot>) {
+        if let (Some(v), Some(d)) = (self.active.and_then(|i| self.views.get_mut(i)), draft) {
+            v.content = d.content.clone(); v.line_editor = d.line.clone(); v.forms = d.form.clone();
+            v.fill_text = d.fill.clone(); v.pending_edit = d.pending.clone();
+        }
+    }
+    pub fn host_pending(&self) -> bool {
+        self.active.and_then(|i| self.views.get(i)).is_some_and(|v| {
+            v.pending_edit.is_some() || v.forms.focus.is_some() || v.content.draft.is_some()
+                || v.line_editor.as_ref().is_some_and(|ed| ed.has_changes())
+                || v.fill_text.as_ref().is_some_and(|t| !t.text.trim().is_empty())
+        })
+    }
+    pub fn host_flush(&mut self) -> bool {
+        self.active_ids().is_none_or(|(_, id)| self.commit_typing_in(id))
+    }
