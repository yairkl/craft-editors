+#[cfg(test)]
+mod host_draft_snapshot_tests {
+    #[test]
+    fn host_draft_snapshot_restores_pending_edit() {
+        let mut app = crate::PdfCraftApp::new();
+        app.open_bytes("draft.pdf", None, include_bytes!("../tests/data/form.pdf").to_vec()).unwrap();
+        assert!(!app.host_pending());
+        assert!(app.host_flush());
+        app.views[0].pending_edit = Some(pdfcraft_engine::Edit::RotatePages { pages: vec![0], degrees: 90 });
+        assert!(app.host_pending());
+        let draft = app.host_draft();
+        app.views[0].pending_edit = None;
+        assert!(!app.host_pending());
+        app.host_restore_draft(&draft);
+        assert!(matches!(app.views[0].pending_edit, Some(pdfcraft_engine::Edit::RotatePages { degrees: 90, .. })));
+        assert!(app.host_pending());
+    }
+}
