+    pub fn host_snapshot(&self, id: DocId) -> crate::HostSnapshot {
+        let Some(doc) = self.get(id) else {
+            return crate::HostSnapshot { editor: None, bytes: Arc::new(Vec::new()) };
+        };
+        crate::HostSnapshot { editor: doc.editor.clone(), bytes: doc.bytes.clone() }
+    }
+    pub fn host_matches(&self, id: DocId, snapshot: &crate::HostSnapshot) -> bool {
+        self.get(id).is_some_and(|doc| Arc::ptr_eq(&doc.bytes, &snapshot.bytes) || doc.bytes == snapshot.bytes)
+    }
+    pub fn host_restore(&mut self, id: DocId, snapshot: &crate::HostSnapshot) -> Result<(), EditError> {
+        let doc = self.doc_mut(id)?;
+        let previous = doc.editor.clone();
+        doc.editor = snapshot.editor.clone();
+        Self::adopt_keys(doc);
+        if let Err(error) = Self::refresh(doc) {
+            doc.editor = previous;
+            Self::adopt_keys(doc);
+            if Self::refresh(doc).is_err() { Self::show_released(doc); }
+            return Err(error);
+        }
+        Self::sync_dirty(doc);
+        doc.generation = doc.generation.saturating_add(1);
+        Ok(())
+    }
