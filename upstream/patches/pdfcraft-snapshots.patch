+#[cfg(test)]
+mod host_snapshot_tests {
+    use super::*;
+
+    #[test]
+    fn host_snapshots_restore_revisions_repeatedly() {
+        let mut session = Session::new();
+        let bytes = session.create_blank(200.0, 300.0, 1).unwrap();
+        let id = session.open_new("snapshot.pdf", bytes).unwrap();
+        let original = session.host_snapshot(id);
+        session.apply(id, Edit::RotatePages { pages: vec![0], degrees: 90 }).unwrap();
+        let rotated = session.host_snapshot(id);
+        assert_eq!(session.get(id).unwrap().info.pages[0].rotation, 90);
+        session.host_restore(id, &original).unwrap();
+        assert_eq!(session.get(id).unwrap().info.pages[0].rotation, 0);
+        assert!(session.host_matches(id, &original));
+        session.host_restore(id, &rotated).unwrap();
+        assert_eq!(session.get(id).unwrap().info.pages[0].rotation, 90);
+        assert!(session.host_matches(id, &rotated));
+        session.host_restore(id, &original).unwrap();
+        assert_eq!(session.get(id).unwrap().info.pages[0].rotation, 0);
+    }
+}
