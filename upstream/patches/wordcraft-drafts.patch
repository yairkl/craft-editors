+
+#[cfg(test)]
+mod host_flush_tests {
+    use super::*;
+
+    #[test]
+    fn host_flush_commits_a_comment_draft_and_preserves_undo() {
+        let mut app = WordApp::new(wordcraft_engine::Session::new(wordcraft_doc::Document::from_text("Hello")), Default::default());
+        app.run("select.text", json!({"text": "Hello"})).unwrap();
+        let id = app.run("review.newComment", json!({"text": "before"})).unwrap()["id"].as_u64().unwrap() as u32;
+        drafts(&mut app).edits.insert(id, "after".into());
+        assert!(has_comment_drafts(&app));
+        app.host_flush().unwrap();
+        assert!(!has_comment_drafts(&app));
+        let part = app.session.doc.comments[&id].part;
+        assert_eq!(app.session.doc.plain_text(StoryRef::Part(part)), "after");
+        app.run("edit.undo", json!({})).unwrap();
+        assert_eq!(app.session.doc.plain_text(StoryRef::Part(part)), "before");
+    }
+}
