@@ -1990,2 +1990,17 @@ fn add_text_reports_overflow_and_takes_a_fit() {
     assert!(point.get("overflow").is_none(), "{point}");
 }
+
+#[test]
+fn headless_render_returns_data_and_writes_png_on_native_hosts() {
+    let mut h = Headless::new();
+    h.call("engine.execute", json!({"command": "file.new", "params": {"width": 20, "height": 20}})).unwrap();
+    let inline = h.call("ui.render", json!({})).unwrap();
+    let bytes = vectorcraft_format::base64_decode(inline["pngBase64"].as_str().unwrap()).unwrap();
+    assert!(bytes.starts_with(b"\x89PNG\r\n\x1a\n"));
+
+    let path = tmp("host-render-native.png");
+    let saved = h.call("ui.render", json!({"path": path.to_str().unwrap(), "data": true})).unwrap();
+    assert_eq!(std::fs::read(&path).unwrap(), bytes);
+    assert_eq!(vectorcraft_format::base64_decode(saved["pngBase64"].as_str().unwrap()).unwrap(), bytes);
+    std::fs::remove_file(path).unwrap();
+}
