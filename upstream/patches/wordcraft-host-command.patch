+
+#[cfg(test)]
+mod host_command_tests {
+    use super::*;
+    use crate::services::Services;
+    use std::cell::Cell;
+    use std::rc::Rc;
+    use wordcraft_engine::Session;
+
+    #[test]
+    fn optional_host_dispatch_preserves_the_standalone_fallback() {
+        let make_session = || Session::new(wordcraft_doc::Document::new());
+        let mut standalone = WordApp::new(make_session(), Services::default());
+        assert!(standalone.run("host.test.unknown", Value::Null).is_err());
+        let calls = Rc::new(Cell::new(0));
+        let seen = Rc::clone(&calls);
+        let services = Services {
+            host_command: Some(Box::new(move |id| {
+                seen.set(seen.get() + 1);
+                id == "host.test.handled"
+            })),
+            ..Default::default()
+        };
+        let mut hosted = WordApp::new(make_session(), services);
+        assert_eq!(hosted.run("host.test.handled", Value::Null).unwrap(), Value::Null);
+        assert!(hosted.run("host.test.unknown", Value::Null).is_err());
+        assert_eq!(calls.get(), 2);
+    }
+}
