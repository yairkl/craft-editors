 /// being edited), in manifest order. Empty when built without craft-fonts or when it has no
 /// Hebrew face.
+static HOST_FONTS: std::sync::OnceLock<&'static [CraftFont]> = std::sync::OnceLock::new();
+/// Register the embedding host's fallback fonts before shaping any text.
+pub fn register_host_fonts(fonts: &'static [CraftFont]) {
+    let _ = HOST_FONTS.set(fonts);
+}
+fn host_fonts() -> &'static [CraftFont] {
+    HOST_FONTS.get().copied().unwrap_or(&[])
+}
 pub fn ui_hebrew_fonts() -> Vec<&'static CraftFont> {
-    CRAFT_FONTS.iter().filter(|f| f.covers("Hebr")).collect()
