diff --git a/crates/fonts/tests/host_fallback.rs b/crates/fonts/tests/host_fallback.rs
new file mode 100644
index 0000000000000000000000000000000000000000..a0438a8d6d63dc0a0f49ba3cc6e221be3f7fa1d8
--- /dev/null
+++ b/crates/fonts/tests/host_fallback.rs
@@ -0,0 +1,20 @@
+use pdfcraft_fonts::{CRAFT_FONTS, CraftFont, document_hebrew_font, register_host_fonts, ui_hebrew_fonts};
+
+static HOST: &[CraftFont] = &[
+    CraftFont { family: "Test host Hebrew", style: "Regular", scripts: &["Hebr"], bytes: &[] },
+    CraftFont { family: "Test host Latin", style: "Regular", scripts: &["Latn"], bytes: &[] },
+];
+static IGNORED: &[CraftFont] = &[CraftFont { family: "Second registration", style: "Regular", scripts: &["Hebr"], bytes: &[] }];
+
+#[test]
+fn host_fallback_is_added_after_upstream_fonts_and_only_registered_once() {
+    let before: Vec<_> = ui_hebrew_fonts().into_iter().map(|f| f.name()).collect();
+    assert_eq!(before.len(), CRAFT_FONTS.iter().filter(|f| f.covers("Hebr")).count());
+    let preferred_before = document_hebrew_font(false).map(|f| f.name());
+    register_host_fonts(HOST);
+    register_host_fonts(IGNORED);
+    let after: Vec<_> = ui_hebrew_fonts().into_iter().map(|f| f.name()).collect();
+    assert_eq!(&after[..before.len()], before.as_slice());
+    assert_eq!(&after[before.len()..], &["Test host Hebrew Regular"]);
+    assert_eq!(document_hebrew_font(false).map(|f| f.name()), Some(preferred_before.unwrap_or_else(|| "Test host Hebrew Regular".into())));
+}
